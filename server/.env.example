# DevPath Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/devpath

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# Allowed Frontend URL for Credentialed CORS
FRONTEND_URL=http://localhost:5173

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Set to true only for offline development/testing without an active Gemini API key
DEVPATH_MOCK_AI=false
